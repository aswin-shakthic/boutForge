{
  "expo": {
    "name": "BoutForge",
    "slug": "boutforge",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "boutforge",
    "userInterfaceStyle": "light",
    "splash": {
      "backgroundColor": "#1B2A4A"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.boutforge.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#1B2A4A"
      },
      "package": "com.boutforge.app"
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": ["expo-router"],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "eas": {
        "projectId": "your-eas-project-id"
      }
    }
  }
}
