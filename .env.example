# BoutForge environment (copy to apps/web/.env.local for local dev)

# Supabase project (Dashboard → Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Canonical app URL — used for invite links when not in a browser.
# LOCAL DEV ONLY: http://localhost:3000
# VERCEL PRODUCTION: https://bout-forge-web-owh5.vercel.app
# Do NOT set localhost in Vercel production — auth emails will break.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Add these exact URLs in Supabase → Authentication → URL configuration:
#   Site URL: <NEXT_PUBLIC_APP_URL>
#   Redirect URLs (one per line):
#     http://localhost:3000/auth/callback
#     http://localhost:3000/reset-password
#     https://YOUR_PRODUCTION_DOMAIN/auth/callback
#     https://YOUR_PRODUCTION_DOMAIN/reset-password
